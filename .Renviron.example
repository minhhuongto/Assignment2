# Copy this file to .Renviron and fill in the values. .Renviron is gitignored.
# R reads it automatically when the project is opened, so nothing needs to be
# set by hand each session.

# WRDS username. The password is not stored here: WRDS authenticates through
# the pgpass file it has you create (%APPDATA%\postgresql\pgpass.conf on
# Windows, ~/.pgpass elsewhere).
WRDS_USER=your_wrds_username

# Subscription key for the Australian Retirement Trust public API. Not secret -
# it is served in the fund's own website JavaScript - but kept out of the
# repository so no key is committed. To find the current value, open
# australianretirementtrust.com.au/investments/performance/unit-prices, and
# search the loaded JavaScript bundles for "apimSubscriptionKeyValue".
ART_SUBSCRIPTION_KEY=your_art_subscription_key
